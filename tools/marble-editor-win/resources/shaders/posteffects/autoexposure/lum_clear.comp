// average lum collector from histogram: https://bruop.github.io/exposure/

#version 450

layout(set = 0, binding = 0) buffer SharedStorage {
    uint histogram[16 * 16];
};

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
void main() {
    histogram[gl_LocalInvocationIndex] = 0;
}
